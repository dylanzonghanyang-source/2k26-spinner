{
  "name": "2k26-spinner",
  "private": true,
  "version": "0.6.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:tendencies": "node scripts/test-tendency-table.mjs && node --experimental-strip-types scripts/test-tendency-lookup.mts && node --experimental-strip-types scripts/test-tendency-names.mts",
    "test:badges": "node scripts/test-badge-profiles.mjs && node --experimental-strip-types scripts/test-badge-tiers.mts && node --experimental-strip-types scripts/test-badge-inheritance.mts && node --experimental-strip-types scripts/test-badge-ovr-model.mts",
    "test:bundle": "node scripts/test-bundle-budget.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "build:budget": "pnpm run build && pnpm run check:bundle",
    "preview": "vite preview",
    "analyze:overall": "node scripts/analyze-overall-calibration.mjs",
    "test:overall": "node scripts/test-rookie-overall-calibration.mjs",
    "test:versioned-overall": "node scripts/test-versioned-overall-model.mjs",
    "test:body": "node --experimental-strip-types scripts/test-rookie-body-constraints.mts",
    "test:durability": "node --experimental-strip-types scripts/test-rookie-durability.mts",
    "test:routing": "node scripts/test-version-routing.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "convert:players": "node scripts/convert-raw-players.mjs",
    "train:overall": "node scripts/train-rookie-overall-model.mjs",
    "train:overall:combined": "node scripts/train-rookie-overall-model.mjs combined src/data/versions/2k26/rookieOverallModel.json && node scripts/train-rookie-overall-model.mjs combined src/data/versions/2k27-play-now/rookieOverallModel.json",
    "backfill:badges": "node scripts/backfill-badges-from-wayback.mjs",
    "sync:badges": "node scripts/sync-versioned-badges.mjs",
    "analyze:badges": "node scripts/analyze-badge-ovr.mjs",
    "scrape:2k": "node scripts/scrape-2kratings.mjs",
    "sync:positions": "node scripts/sync-current-player-positions.mjs",
    "update:rosters": "node scripts/update-current-rosters.mjs",
    "sync:latest-roster": "node scripts/sync-latest-2k27-roster.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.542.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^7.0.6"
  }
}
