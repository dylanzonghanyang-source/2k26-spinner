  "cases": [
    {
      "id": "F01",
      "title": "Position label must not change atomic attributes",
      "kind": "pair_invariance",
      "notes": "Run identical donor/body/support graph twice; only targetPosition differs PG vs C. Atomic engine must ignore position.",
      "inputs": {
        "mutations": [
          {
            "targetPosition": "PG"
          },
          {
            "targetPosition": "C"
          }
        ]
      },
      "expected": {
        "relation": "allAtomicAttributesEqual",
        "tolerance": 0
      }
    },
    {
      "id": "F02",
      "title": "Passing is body-invariant",
      "kind": "variants",
      "notes": "Pass Accuracy has no structural/support dependencies.",
      "inputs": {
        "variants": [
          {
            "raw": 94,
            "targetBody": {
              "heightCm": 180,
              "weightKg": 59.940000000000005
            },
            "targetPosition": "PG"
          },
          {
            "raw": 94,
            "targetBody": {
              "heightCm": 225,
              "weightKg": 167.0625
            },
            "targetPosition": "C"
          }
        ],
        "attribute": "Pass Accuracy"
      },
      "expected": {
        "finalByVariant": [
          94,
          94
        ]
      }
    },
    {
      "id": "F03",
      "title": "Support never buffs low raw skill",
      "kind": "atomic",
      "notes": "Agility 99 cannot manufacture Ball Handle above donor raw 42.",
      "inputs": {
        "attribute": "Ball Handle",
        "raw": 42,
        "sourceBody": {
          "heightCm": 200,
          "weightKg": 98.0
        },
        "sourceSupports": {
          "Agility": 80
        },
        "targetBody": {
          "heightCm": 195,
          "weightKg": 91.25999999999999
        },
        "targetFinalSupports": {
          "Agility": 99
        }
      },
      "expected": {
        "final": 42,
        "finalBeforeRound": 42
      }
    },
    {
      "id": "F04",
      "title": "Ceiling model protects already-low raw ratings",
      "kind": "variants",
      "notes": "Same broken support hardware: raw 60 stays 60 because support ceiling is 67; raw 95 is capped to 67.",
      "inputs": {
        "attribute": "Speed with Ball",
        "sourceBody": {
          "heightCm": 200,
          "weightKg": 98.0
        },
        "sourceSupports": {
          "Speed": 90,
          "Ball Handle": 90,
          "Agility": 80
        },
        "targetBody": {
          "heightCm": 195,
          "weightKg": 91.25999999999999
        },
        "targetFinalSupports": {
          "Speed": 50,
          "Ball Handle": 45,
          "Agility": 40
        },
        "rawVariants": [
          60,
          95
        ]
      },
      "expected": {
        "supportCeiling": 67,
        "finalByRaw": [
          60,
          67
        ]
      }
    },
    {
      "id": "F05",
      "title": "Donor self-reproduction property",
      "kind": "dataset_property",
